# Copy to .env and replace placeholders. Never commit .env.

# Supabase PostgreSQL connection (production or local migration target)
FISHOPS_DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:5432/postgres?sslmode=require&options=-csearch_path%3Dprospects%2Cpublic

# Authorized administrator email addresses
FISHOPS_ADMIN_EMAIL_1=mburutracy81@gmail.com
FISHOPS_ADMIN_EMAIL_2=njorogestan12@gmail.com

# Override output directories
# FISHOPS_DATA_DIR=./data
# FISHOPS_RAW_DIR=./data/raw

# Default country for collectors
# FISHOPS_DEFAULT_COUNTRY=KE
